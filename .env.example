PORT=3000
EVOLUTION_BASE_URL=http://evolution-api:8080
EVOLUTION_API_KEY=replace-me
WEBHOOK_SHARED_SECRET=replace-with-random-secret-at-least-16-chars
EVOLUTION_DOCKER_NETWORK=replace-with-evolution-network
CONFIG_PATH=/app/config/distribuidoras.json
CONFIG_WRITABLE_PATH=/app/data/distribuidoras.json
ADMIN_ENABLED=false
ADMIN_USERNAME=
# Generate using npm run admin:password. Base64 preserves dollar signs in Compose.
ADMIN_PASSWORD_HASH_B64=
ADMIN_ORIGIN=https://central.example.com
ADMIN_ALLOW_HTTP=false
SQLITE_PATH=/app/data/state.sqlite
CONFIG_POLL_MS=5000
WORKER_POLL_MS=1000
RETENTION_DAYS=30
